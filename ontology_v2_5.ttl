    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Requirement ;
    skos:definition "Atomic, testable duty derived from a regulation summary. The hub that controls, policy requirements and procedure steps satisfy."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Regulatory Source" ;
    rc:sourceSystem "RegMap ROB_ID" .

rc:ModelRun a owl:Class ;
    rdfs:label "Model Run"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "One pipeline execution: model, prompt version, schema, candidate route, quality-gate status and failure rate."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Provenance & AI Governance" ;
    rc:sourceSystem "Run manifest" .

rc:ProcedureStep a owl:Class ;
    rdfs:label "Procedure Step"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "An operational action or ordered step in a procedure that satisfies a requirement (the 'how')."@en ;
    rc:dataStatus "PARTIAL" ;
    rc:module "Policy & Procedure" ;
    rc:sourceSystem "LLM extraction from procedures" .

rc:Regulation a owl:Class ;
    rdfs:label "Regulation (RGL)"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Canonical regulatory instrument tracked in RegMap; anchor of structural lineage."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Regulatory Source" ;
    rc:sourceSystem "RegMap REG_ID" .

rc:Control a owl:Class ;
    rdfs:label "Control Instance (1C)"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Implemented control operated by a business or function; satisfies requirements."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Control" ;
    rc:sourceSystem "Helios control" .

rc:RegulatoryAlert a owl:Class ;
    rdfs:label "Regulatory Alert"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Trigger ;
    skos:definition "Incoming vendor or regulator notification of change. A Trigger that initiates impact assessment. At intake it is standardised: tested for applicability (Yes/No), given a category (RD, Consultation, News, Fine) and contextualised by ML classifiers (risk steward, theme, risk taxonomy L1–L3, line of business, legal entity)."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Regulatory Change" ;
    rc:sourceSystem "Rapid2 RECORD_ID" .

rc:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Abstract superclass for any binding or advisory statement (regulatory obligation or internal policy requirement). Strength is carried by hasModality (MUST, MUST_NOT, MAY, SHOULD)."@en ;
    rc:dataStatus "DERIVED" ;
    rc:module "Requirement Semantics" .

rc:LinkAssertion a owl:Class ;
    rdfs:label "Link Assertion"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Reified inferred link between any two entities (alert→summary, alert→control, obligation→policy requirement…) with decision, scores, granularity, method, evidence and SME status. Impact edges are materialised only from CONFIRMED assertions."@en ;
    rc:dataStatus "AVAILABLE" ;
    rc:module "Provenance & AI Governance" ;
    rc:sourceSystem "Pipeline verdicts / golden / SME" .

<https://ontology.hsbc.internal/regcomp/def> a owl:Ontology ;
    dcterms:created "2026-10-30"^^xsd:date ;
    dcterms:description "Regulatory alert -> regulation / summary / obligation -> policy / procedure -> risk / control standard / live control, with AI link assertions (provenance, judge verdict, SME status) and gap findings. Generated from the explorer model block; working store is a property graph."@en ;
    dcterms:title "HSBC Regulatory Compliance Ontology"@en ;
    owl:versionInfo "2.5" .

rc:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:isDefinedBy <https://ontology.hsbc.internal/regcomp/def> ;
    skos:definition "Abstract root of every node. Carries identity, source system and bitemporal validity (validFrom/validTo, recordedAt)."@en ;
    rc:dataStatus "DERIVED" ;
    rc:module "Provenance & AI Governance" .

