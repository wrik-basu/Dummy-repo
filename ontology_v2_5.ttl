@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rc: <https://ontology.hsbc.internal/regcomp/def#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rc:addressesRiskType a owl:ObjectProperty ;
    rdfs:label "addresses risk type"@en ;
    rdfs:comment "GPPS procedure addresses a risk taxonomy node (GPPS objRel RISK, text only)."@en ;
    rdfs:domain rc:Procedure ;
    rdfs:range rc:RiskTaxonomyNode ;
    rc:graphProperty "addressesRiskType" .

rc:affectsObligation a owl:ObjectProperty ;
    rdfs:label "affects obligation"@en ;
    rdfs:comment "Materialised from CONFIRMED assertions only"@en ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:RegulatoryObligation .

rc:affectsSummary a owl:ObjectProperty ;
    rdfs:label "affects summary"@en ;
    rdfs:comment "Materialised from CONFIRMED assertions only"@en ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:RegulatorySummary .

rc:amendedBy a owl:ObjectProperty ;
    rdfs:label "amended by"@en ;
    owl:inverseOf rc:amends .

rc:answeredUsing a owl:ObjectProperty ;
    rdfs:label "answered using"@en ;
    rdfs:comment "Class traceability"@en ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range rc:Entity .

rc:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "applies in jurisdiction"@en ;
    rdfs:domain rc:Regulation ;
    rdfs:range rc:Jurisdiction .

rc:appliesToScope a owl:ObjectProperty ;
    rdfs:label "applies to scope"@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:ApplicabilityScope .

rc:arisesFrom a owl:ObjectProperty ;
    rdfs:label "arises from"@en ;
    owl:inverseOf rc:givesRiseTo .

rc:assertionObject a owl:ObjectProperty ;
    rdfs:label "assertion object"@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range rc:Entity .

rc:assertionSubject a owl:ObjectProperty ;
    rdfs:label "assertion subject"@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range rc:Entity .

rc:assessedFor a owl:ObjectProperty ;
    rdfs:label "assessed for"@en ;
    rdfs:comment "The business the assessment is for."@en ;
    rdfs:domain rc:RegulationAssessment ;
    rdfs:range rc:BusinessUnit ;
    rc:graphProperty "assessedFor" .

rc:assessesRegulation a owl:ObjectProperty ;
    rdfs:label "assesses regulation"@en ;
    rdfs:comment "The regulation the assessment covers."@en ;
    rdfs:domain rc:RegulationAssessment ;
    rdfs:range rc:Regulation ;
    rc:graphProperty "assessesRegulation" .

rc:assessmentOf a owl:ObjectProperty ;
    rdfs:label "assessment of"@en ;
    owl:inverseOf rc:initiatesAssessment .

rc:assessmentStatus a owl:DatatypeProperty ;
    rdfs:comment "OPEN, IN_REVIEW or CLOSED."@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range xsd:string .

rc:assignedTo a owl:ObjectProperty ;
    rdfs:label "assigned to"@en ;
    rdfs:comment "Risk Steward"@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:Person .

rc:automatedBy a owl:ObjectProperty ;
    rdfs:label "automated by"@en ;
    rdfs:domain rc:Control ;
    rdfs:range rc:System .

rc:candidateRoute a owl:DatatypeProperty ;
    rdfs:comment "Candidate-generation route (e.g. RGL→RSM)."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:changeNeeded a owl:DatatypeProperty ;
    rdfs:comment "What the document owner should look at (impact links)."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:string .

rc:changes a owl:ObjectProperty ;
    rdfs:label "changes"@en ;
    rdfs:domain rc:RemediationAction ;
    rdfs:range rc:Entity .

rc:charEnd a owl:DatatypeProperty ;
    rdfs:comment "Exclusive end offset in the source text."@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:integer .

rc:charStart a owl:DatatypeProperty ;
    rdfs:comment "Inclusive start offset in the source text."@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:integer .

rc:citesProvision a owl:ObjectProperty ;
    rdfs:label "cites provision"@en ;
    rdfs:domain rc:RegulatoryObligation ;
    rdfs:range rc:Provision .

rc:classifiedAs a owl:ObjectProperty ;
    rdfs:label "classified as"@en ;
    rdfs:comment "L1–L3"@en ;
    rdfs:domain rc:LibraryRisk ;
    rdfs:range rc:RiskTaxonomyNode .

rc:concerns a owl:ObjectProperty ;
    rdfs:label "concerns"@en ;
    rdfs:comment "Obligation, control, policy requirement or procedure step"@en ;
    rdfs:domain rc:ImpactFinding ;
    rdfs:range rc:Entity .

rc:confidenceScore a owl:DatatypeProperty ;
    rdfs:comment "Model confidence 1–5."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:integer .

rc:configHash a owl:DatatypeProperty ;
    rdfs:comment "Hash of run configuration for replay."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:confirmed a owl:DatatypeProperty ;
    rdfs:comment "LINKED + judge AGREE with verified quotes: the only links that count."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:boolean .

rc:contextualisedBy a owl:ObjectProperty ;
    rdfs:label "contextualised by"@en ;
    rdfs:comment "Intake classifiers that produced the tags (replayable)"@en ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range rc:ModelRun .

rc:cqText a owl:DatatypeProperty ;
    rdfs:comment "The question in business language."@en ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range xsd:string .

rc:dataStatus a owl:AnnotationProperty .

rc:decomposesTo a owl:ObjectProperty ;
    rdfs:label "decomposes to"@en ;
    owl:inverseOf rc:derivedFromSummary .

rc:definesTerm a owl:ObjectProperty ;
    rdfs:label "defines term"@en ;
    rdfs:domain rc:Provision ;
    rdfs:range rc:DefinedTerm .

rc:definitionText a owl:DatatypeProperty ;
    rdfs:comment "Gloss of a defined term."@en ;
    rdfs:domain rc:DefinedTerm ;
    rdfs:range xsd:string .

rc:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:comment "No orphan findings"@en ;
    rdfs:domain rc:ImpactFinding ;
    rdfs:range rc:LinkAssertion .

rc:effectiveDate a owl:DatatypeProperty ;
    rdfs:comment "Date a regulation, change or requirement takes effect."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:date .

rc:enforcesIn a owl:ObjectProperty ;
    rdfs:label "enforces in"@en ;
    rdfs:domain rc:Regulator ;
    rdfs:range rc:Jurisdiction .

rc:evaluatesObligation a owl:ObjectProperty ;
    rdfs:label "evaluates obligation"@en ;
    rdfs:comment "An obligation evaluated (in scope or not) by the assessment."@en ;
    rdfs:domain rc:RegulationAssessment ;
    rdfs:range rc:RegulatoryObligation ;
    rc:graphProperty "evaluatesObligation" .

rc:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidence for"@en ;
    owl:inverseOf rc:hasEvidence .

rc:evidenceSide a owl:DatatypeProperty ;
    rdfs:comment "SUBJECT or OBJECT: which side of an assertion the quote comes from."@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:string .

rc:exempts a owl:ObjectProperty ;
    rdfs:label "exempts"@en ;
    rdfs:domain rc:Exception ;
    rdfs:range rc:ProcedureStep .

rc:explosionApproved a owl:DatatypeProperty ;
    rdfs:comment "True only when a coarse (RGL) link is explicitly approved to fan out to controls."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:boolean .

rc:extractedFrom a owl:ObjectProperty ;
    rdfs:label "extracted from"@en ;
    rdfs:comment "Source document / record"@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range rc:Entity .

rc:gateStatus a owl:DatatypeProperty ;
    rdfs:comment "Quality gate result: PASS, FAIL or NOT_MEASURED."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:governsActivity a owl:ObjectProperty ;
    rdfs:label "governs activity"@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:ProcedureStep ;
    rc:graphProperty "governsActivity" .

rc:graphProperty a owl:AnnotationProperty ;
    rdfs:comment "Name of the edge property in the working property graph (edges.parquet)."@en .

rc:hasApplicability a owl:ObjectProperty ;
    rdfs:comment "Value from the Applicability concept scheme."@en ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range skos:Concept .

rc:hasAuditLabel a owl:ObjectProperty ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasBlastRadius a owl:ObjectProperty ;
    rdfs:label "has blast radius"@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:BlastRadius .

rc:hasCategory a owl:ObjectProperty ;
    rdfs:comment "Value from the AlertCategory concept scheme."@en ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range skos:Concept .

rc:hasChangeType a owl:ObjectProperty ;
    rdfs:comment "Value from the ChangeType concept scheme."@en ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range skos:Concept .

rc:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:Condition .

rc:hasControlNature a owl:ObjectProperty ;
    rdfs:comment "Value from the ControlNature concept scheme."@en ;
    rdfs:domain rc:Control ;
    rdfs:range skos:Concept .

rc:hasCoverage a owl:ObjectProperty ;
    rdfs:comment "Value from the Coverage concept scheme."@en ;
    rdfs:domain rc:Gap ;
    rdfs:range skos:Concept .

rc:hasDecision a owl:ObjectProperty ;
    rdfs:comment "Value from the LinkDecision concept scheme."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:ImpactFinding .

rc:hasGapCategory a owl:ObjectProperty ;
    rdfs:domain rc:Gap ;
    rdfs:range skos:Concept .

rc:hasGranularity a owl:ObjectProperty ;
    rdfs:comment "Value from the Granularity concept scheme."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasGrounding a owl:ObjectProperty ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasImpactType a owl:ObjectProperty ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasInstance a owl:ObjectProperty ;
    rdfs:label "has instance"@en ;
    owl:inverseOf rc:instanceOf .

rc:hasJudgeVerdict a owl:ObjectProperty ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasMethod a owl:ObjectProperty ;
    rdfs:comment "Value from the LinkMethod concept scheme."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasModality a owl:ObjectProperty ;
    rdfs:comment "Value from the Modality concept scheme."@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range skos:Concept .

rc:hasReliabilityTier a owl:ObjectProperty ;
    rdfs:comment "Value from the ReliabilityTier concept scheme."@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range skos:Concept .

rc:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    rdfs:domain rc:Person ;
    rdfs:range rc:Role .

rc:hasSMEStatus a owl:ObjectProperty ;
    rdfs:comment "Value from the SMEStatus concept scheme."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept .

rc:hasSummary a owl:ObjectProperty ;
    rdfs:label "has summary"@en ;
    owl:inverseOf rc:partOfRegulation .

rc:hasTemporalConstraint a owl:ObjectProperty ;
    rdfs:label "has temporal constraint"@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:TemporalConstraint .

rc:hasTemporalType a owl:ObjectProperty ;
    rdfs:comment "Value from the TemporalType concept scheme."@en ;
    rdfs:domain rc:TemporalConstraint ;
    rdfs:range skos:Concept .

rc:identifiesGap a owl:ObjectProperty ;
    rdfs:label "identifies gap"@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:Gap .

rc:impactsControl a owl:ObjectProperty ;
    rdfs:label "impacts control"@en ;
    rdfs:comment "Materialised from CONFIRMED assertions only"@en ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:Control .

rc:impactsPolicyRequirement a owl:ObjectProperty ;
    rdfs:label "impacts policy requirement"@en ;
    rdfs:comment "Materialised from CONFIRMED assertions only"@en ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:PolicyRequirement .

rc:implementedByPolicyViaControl a owl:ObjectProperty ;
    rdfs:label "implemented by policy via control"@en ;
    rdfs:comment "Derived by rule (no AI): obligation -> its confirmed control standard -> the same control mapped in GPPS to the policy. Superseded by LLM + judge links where they exist."@en ;
    rdfs:domain rc:RegulatoryObligation ;
    rdfs:range rc:Policy ;
    rdfs:subPropertyOf rc:implementedByPolicy ;
    rc:graphProperty "implementedByPolicyViaControl" .

rc:implementsPolicy a owl:ObjectProperty ;
    rdfs:label "implements policy"@en ;
    rdfs:domain rc:Procedure ;
    rdfs:range rc:Policy ;
    rc:graphProperty "implementsPolicy" .

rc:inJurisdiction a owl:ObjectProperty ;
    rdfs:label "in jurisdiction"@en ;
    rdfs:comment "Intake: location of the alert"@en ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range rc:Jurisdiction ;
    rc:graphProperty "inJurisdiction" .

rc:initiates a owl:ObjectProperty ;
    rdfs:label "initiates"@en ;
    rdfs:domain rc:Trigger ;
    rdfs:range rc:Requirement .

rc:issueOf a owl:ObjectProperty ;
    rdfs:label "issue of"@en ;
    owl:inverseOf rc:hasIssue .

rc:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    owl:inverseOf rc:issues .

rc:issuedByRegulator a owl:ObjectProperty ;
    rdfs:label "issued by regulator"@en ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range rc:Regulator ;
    rc:graphProperty "issuedByRegulator" .

rc:label a owl:DatatypeProperty ;
    rdfs:comment "Human-readable name or title."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:leadsTo a owl:ObjectProperty ;
    rdfs:label "leads to"@en ;
    rdfs:comment "Sequence"@en ;
    rdfs:domain rc:ProcedureStep ;
    rdfs:range rc:ProcedureStep .

rc:licensedIn a owl:ObjectProperty ;
    rdfs:label "licensed in"@en ;
    rdfs:domain rc:LegalEntity ;
    rdfs:range rc:Jurisdiction .

rc:linkScore a owl:DatatypeProperty ;
    rdfs:comment "Model link score 0-10."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:integer .

rc:linkedSections a owl:DatatypeProperty ;
    rdfs:comment "GPPS sections the link rests on, e.g. 'S5 | 4 Third Party Agreements'."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:string .

rc:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:domain rc:Person ;
    rdfs:range rc:Team .

rc:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    owl:inverseOf rc:mitigatedBy .

rc:modelId a owl:DatatypeProperty ;
    rdfs:comment "Model identifier on the GenAI gateway."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:module a owl:AnnotationProperty .

rc:nBusinesses a owl:DatatypeProperty ;
    rdfs:comment "Count of businesses in scope."@en ;
    rdfs:domain rc:BlastRadius ;
    rdfs:range xsd:integer .

rc:nControls a owl:DatatypeProperty ;
    rdfs:comment "Count of impacted controls."@en ;
    rdfs:domain rc:BlastRadius ;
    rdfs:range xsd:integer .

rc:nLegalEntities a owl:DatatypeProperty ;
    rdfs:comment "Count of legal entities in scope."@en ;
    rdfs:domain rc:BlastRadius ;
    rdfs:range xsd:integer .

rc:nObligations a owl:DatatypeProperty ;
    rdfs:comment "Count of affected obligations."@en ;
    rdfs:domain rc:BlastRadius ;
    rdfs:range xsd:integer .

rc:nPolicyRequirements a owl:DatatypeProperty ;
    rdfs:comment "Count of impacted policy requirements."@en ;
    rdfs:domain rc:BlastRadius ;
    rdfs:range xsd:integer .

rc:narrowerJurisdiction a owl:ObjectProperty ;
    rdfs:label "narrower jurisdiction"@en ;
    owl:inverseOf rc:broaderJurisdiction .

rc:narrowerRisk a owl:ObjectProperty ;
    rdfs:label "narrower risk"@en ;
    owl:inverseOf rc:broaderRisk .

rc:onRequirement a owl:ObjectProperty ;
    rdfs:label "on requirement"@en ;
    rdfs:domain rc:Gap ;
    rdfs:range rc:Requirement ;
    owl:inverseOf rc:hasGap .

rc:ontologyVersion a owl:DatatypeProperty ;
    rdfs:comment "Ontology version the node was written under."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:operatedFor a owl:ObjectProperty ;
    rdfs:label "operated for"@en ;
    rdfs:domain rc:Control ;
    rdfs:range rc:LegalEntity .

rc:operatedIn a owl:ObjectProperty ;
    rdfs:label "operated in"@en ;
    rdfs:domain rc:Control ;
    rdfs:range rc:BusinessUnit .

rc:overriddenBy a owl:ObjectProperty ;
    rdfs:label "overridden by"@en ;
    owl:inverseOf rc:overrides .

rc:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:comment "Control owner | Policy owner"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( rc:Control rc:Policy ) ] ;
    rdfs:range rc:Actor .

rc:partOfBusiness a owl:ObjectProperty ;
    rdfs:label "part of business"@en ;
    rdfs:domain rc:BusinessUnit ;
    rdfs:range rc:BusinessUnit .

rc:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( rc:ProcedureStep rc:SMEValidation ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rc:Person rc:Role ) ] .

rc:policyMapsToControl a owl:ObjectProperty ;
    rdfs:label "policy maps to control"@en ;
    rdfs:comment "GPPS policy section maps a Helios control standard (GPPS objRel CNTRL)."@en ;
    rdfs:domain rc:Policy ;
    rdfs:range rc:LibraryControl ;
    rc:graphProperty "policyMapsToControl" .

rc:policyMapsToRegulation a owl:ObjectProperty ;
    rdfs:label "policy maps to regulation"@en ;
    rdfs:comment "GPPS policy maps a RegMap regulation (GPPS objRel REG)."@en ;
    rdfs:domain rc:Policy ;
    rdfs:range rc:Regulation ;
    rc:graphProperty "policyMapsToRegulation" .

rc:priority a owl:DatatypeProperty ;
    rdfs:comment "MUST, SHOULD or COULD."@en ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range xsd:string .

rc:procedureMapsToControl a owl:ObjectProperty ;
    rdfs:label "procedure maps to control"@en ;
    rdfs:comment "GPPS procedure section maps a Helios control standard (GPPS objRel CNTRL)."@en ;
    rdfs:domain rc:Procedure ;
    rdfs:range rc:LibraryControl ;
    rc:graphProperty "procedureMapsToControl" .

rc:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "Required when method is AI"@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range rc:ModelRun .

rc:promptVersion a owl:DatatypeProperty ;
    rdfs:comment "Prompt version used."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:provisionOf a owl:ObjectProperty ;
    rdfs:label "provision of"@en ;
    owl:inverseOf rc:hasProvision .

rc:publishedAs a owl:ObjectProperty ;
    rdfs:label "published as"@en ;
    rdfs:domain rc:Regulation ;
    rdfs:range rc:RegulatoryDocument .

rc:rationale a owl:DatatypeProperty ;
    rdfs:comment "Reasoning text for a decision, finding or validation."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:recordedAt a owl:DatatypeProperty ;
    rdfs:comment "System time the fact was recorded (bitemporal)."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:dateTime .

rc:relatedPolicy a owl:ObjectProperty ;
    rdfs:label "related policy"@en ;
    rdfs:comment "GPPS policy references another policy (GPPS objRel PLCY)."@en ;
    rdfs:domain rc:Policy ;
    rdfs:range rc:Policy ;
    rc:graphProperty "relatedPolicy" .

rc:relevanceScore a owl:DatatypeProperty ;
    rdfs:comment "Model relevance 0–10."@en ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:decimal .

rc:remediatedBy a owl:ObjectProperty ;
    rdfs:label "remediated by"@en ;
    rdfs:domain rc:Gap ;
    rdfs:range rc:RemediationAction .

rc:reportedBy a owl:ObjectProperty ;
    rdfs:label "reported by"@en ;
    owl:inverseOf rc:reportsChange .

rc:requirementOf a owl:ObjectProperty ;
    rdfs:label "requirement of"@en ;
    owl:inverseOf rc:hasRequirement .

rc:responsibleParty a owl:ObjectProperty ;
    rdfs:label "responsible party"@en ;
    rdfs:comment "Who the duty falls on"@en ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:Actor .

rc:runId a owl:DatatypeProperty ;
    rdfs:comment "Run identifier written on every edge (run_id)."@en ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string .

rc:satisfiedByControlInstance a owl:ObjectProperty ;
    rdfs:label "satisfied by control instance"@en ;
    rdfs:comment "Obligation is performed by a live control instance (phase 3b level 2; confirmed = LLM + judge)."@en ;
    rdfs:domain rc:RegulatoryObligation ;
    rdfs:range rc:Control ;
    rdfs:subPropertyOf rc:satisfiedBy ;
    rc:graphProperty "satisfiedByControlInstance" .

rc:scopesBusiness a owl:ObjectProperty ;
    rdfs:label "scopes business"@en ;
    rdfs:domain rc:ApplicabilityScope ;
    rdfs:range rc:BusinessUnit .

rc:scopesJurisdiction a owl:ObjectProperty ;
    rdfs:label "scopes jurisdiction"@en ;
    rdfs:domain rc:ApplicabilityScope ;
    rdfs:range rc:Jurisdiction .

rc:scopesLegalEntity a owl:ObjectProperty ;
    rdfs:label "scopes legal entity"@en ;
    rdfs:domain rc:ApplicabilityScope ;
    rdfs:range rc:LegalEntity .

rc:scopesProcess a owl:ObjectProperty ;
    rdfs:label "scopes process"@en ;
    rdfs:domain rc:ApplicabilityScope ;
    rdfs:range rc:Process .

rc:scopesProduct a owl:ObjectProperty ;
    rdfs:label "scopes product"@en ;
    rdfs:domain rc:ApplicabilityScope ;
    rdfs:range rc:Product .

rc:sectionRef a owl:DatatypeProperty ;
    rdfs:comment "Section, article or field the quote comes from."@en ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:string .

rc:signedOffBy a owl:ObjectProperty ;
    rdfs:label "signed off by"@en ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:Person .

rc:sourceId a owl:DatatypeProperty ;
    rdfs:comment "Identifier in the system of record (REG_ID, SUM_ID, ROB_ID, RECORD_ID, Helios id …)."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:sourceSystem a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:comment "System of record the node was loaded from."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:sparql a owl:DatatypeProperty ;
    rdfs:comment "Executable SPARQL that answers the question."@en ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range xsd:string .

rc:statement a owl:DatatypeProperty ;
    rdfs:comment "Full text of a requirement, summary, control or step."@en ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:string .

rc:status a owl:DatatypeProperty ;
    rdfs:comment "Lifecycle status in the source system (PUBLISHED, RETIRED …)."@en ;
    rdfs:domain rc:Entity ;
