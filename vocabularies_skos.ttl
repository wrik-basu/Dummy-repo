vc:AssessmentStatus a skos:ConceptScheme ;
    skos:definition "Lifecycle of an impact assessment"@en ;
    skos:prefLabel "Assessment Status"@en .

vc:Coverage a skos:ConceptScheme ;
    skos:definition "How fully a requirement is covered"@en ;
    skos:prefLabel "Coverage"@en .

vc:GroundingFlag a skos:ConceptScheme ;
    skos:definition "Whether the model's verbatim quotes were found in both texts by code"@en ;
    skos:prefLabel "Grounding Flag"@en .

vc:ImpactType a skos:ConceptScheme ;
    skos:definition "What an impact means for the document owner"@en ;
    skos:prefLabel "Impact Type"@en .

vc:LinkDecision a skos:ConceptScheme ;
    skos:definition "Outcome of a linkage judgement"@en ;
    skos:prefLabel "Link Decision"@en .

vc:ReliabilityTier a skos:ConceptScheme ;
    skos:definition "How strongly evidence is treated as truth"@en ;
    skos:prefLabel "Reliability Tier"@en .

vc:AlertCategory a skos:ConceptScheme ;
    skos:definition "Intake category of an alert"@en ;
    skos:prefLabel "Alert Category"@en .

vc:ControlNature a skos:ConceptScheme ;
    skos:definition "Control classification"@en ;
    skos:prefLabel "Control Nature"@en .

vc:JudgeVerdict a skos:ConceptScheme ;
    skos:definition "Independent judge verdict on a model decision"@en ;
    skos:prefLabel "Judge Verdict"@en .

vc:Modality a skos:ConceptScheme ;
    skos:definition "Normative strength of a requirement"@en ;
    skos:prefLabel "Modality"@en .

vc:SMEStatus a skos:ConceptScheme ;
    skos:definition "Human review state of an assertion"@en ;
    skos:prefLabel "S M E Status"@en .

vc:CustomerSegment a skos:ConceptScheme ;
    skos:definition "Customer segment qualifier for scope"@en ;
    skos:prefLabel "Customer Segment"@en .

vc:GapCategory a skos:ConceptScheme ;
    skos:definition "Control gap category of an obligation (from judge-confirmed links only)"@en ;
    skos:prefLabel "Gap Category"@en .

vc:TemporalType a skos:ConceptScheme ;
    skos:definition "Kind of time bound"@en ;
    skos:prefLabel "Temporal Type"@en .

vc:ChangeType a skos:ConceptScheme ;
    skos:definition "Kind of regulatory change"@en ;
    skos:prefLabel "Change Type"@en .

vc:LinkMethod a skos:ConceptScheme ;
    skos:definition "How an assertion was produced"@en ;
    skos:prefLabel "Link Method"@en .

vc:AuditLabel a skos:ConceptScheme ;
    skos:definition "Label from the judge audit"@en ;
    skos:prefLabel "Audit Label"@en .

vc:Granularity a skos:ConceptScheme ;
    skos:definition "Level at which an assertion is made"@en ;
    skos:prefLabel "Granularity"@en .

