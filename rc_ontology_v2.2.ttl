rc:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Criterion evaluated before an obligation applies (threshold, risk class, status). Gates applicability; not an event." ;
    rc:dataStatus "DERIVED" ;
    rc:disambiguationRule "Condition is evaluated; Trigger happens." ;
    rc:llmGuidance "Condition is a test that is evaluated (if/where/provided that). An event that happens is a Trigger." ;
    rc:module rc:Module_SEM ;
    rc:negativeExample "When the alert is received (that is a Trigger)." ;
    rc:positiveExample "Where the AI system is used to evaluate creditworthiness" ;
    rc:promptEligible true ;
    rc:servesCQ "CQ06" ;
    rc:sourceSystemName "LLM extraction from ROB text" .

rc:Exception a owl:Class ;
    rdfs:label "Exception / Exemption" ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Documented carve-out that disapplies or overrides a requirement." ;
    rc:changeNote "Gains overrides / exempts" ;
    rc:dataStatus "DERIVED" ;
    rc:disambiguationRule "Exception carves out from a named requirement; link with overrides." ;
    rc:llmGuidance "Link with overrides to the Requirement it carves out from." ;
    rc:module rc:Module_SEM ;
    rc:negativeExample "A general statement of scope is a scope, not an exception." ;
    rc:positiveExample "except for AI systems used for the purpose of detecting financial fraud" ;
    rc:promptEligible true ;
    rc:servesCQ "CQ06" ;
    rc:sourceSystemName "LLM extraction from ROB text" .

