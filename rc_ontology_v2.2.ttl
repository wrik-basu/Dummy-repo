rc:LinkAssertion a owl:Class ;
    rdfs:label "Link Assertion" ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Reified inferred link between any two entities (alert→summary, alert→control, obligation→policy requirement…) with decision, scores, granularity, method, evidence and SME status. Impact edges are materialised only from CONFIRMED assertions." ;
    rc:changeNote "Core differentiator — unchanged in intent, tightened rules" ;
