rc:RegulatoryObligation a owl:Class ;
    rdfs:label "Regulatory Obligation (ROB)" ;
    rdfs:subClassOf rc:Requirement ;
    skos:definition "Atomic, testable duty derived from a regulation summary. The hub that controls, policy requirements and procedure steps satisfy." ;
    rc:changeNote "Now a Requirement subclass" ;
    rc:dataStatus "AVAILABLE" ;
    rc:disambiguationRule "Obligation imposes a duty; Condition only gates it; Informational text imposes nothing." ;
    rc:llmGuidance "Classify modality from verbs: must/shall → MUST; must not/shall not/may not → MUST_NOT; may/is permitted → MAY; should/is expected → SHOULD. One obligation per testable duty." ;
    rc:module rc:Module_REG ;
    rc:negativeExample "This Regulation aims to improve the functioning of the internal market (recital — informational, not an obligation)." ;
    rc:positiveExample "Providers of high-risk AI systems shall ensure that the system is designed to allow effective human oversight." ;
    rc:promptEligible true ;
    rc:servesCQ "CQ01",
        "CQ02",
        "CQ03",
        "CQ04",
        "CQ05",
        "CQ09" ;
    rc:sourceSystemName "RegMap ROB_ID" .

rc:Requirement a owl:Class ;
    rdfs:label "Requirement" ;
    rdfs:subClassOf rc:Entity ;
    skos:definition "Abstract superclass for any binding or advisory statement (regulatory obligation or internal policy requirement). Strength is carried by hasModality (MUST, MUST_NOT, MAY, SHOULD)." ;
    rc:changeNote "NEW" ;
    rc:dataStatus "DERIVED" ;
    rc:module rc:Module_SEM ;
    rc:servesCQ "CQ01",
        "CQ05",
        "CQ09" ;
