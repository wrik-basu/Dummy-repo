@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rc: <https://ontology.hsbc.internal/regcompliance#> .
@prefix rcv: <https://ontology.hsbc.internal/regcompliance/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.hsbc.internal/regcompliance> a owl:Ontology ;
    rdfs:label "HSBC Regulatory Compliance & Impact Assessment Ontology" ;
    dcterms:description "Regulatory change → obligation → risk → control → policy/procedure impact ontology with AI link governance, bitemporal lineage and competency-question traceability." ;
    owl:priorVersion <https://ontology.hsbc.internal/regcompliance/2.1.0> ;
    owl:versionIRI <https://ontology.hsbc.internal/regcompliance/2.2.0> ;
    owl:versionInfo "2.2.0" .

rc:CQ01 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:RegulatoryAlert,
        rc:RegulatoryChange,
        rc:RegulatoryObligation,
        rc:RegulatorySummary,
        rc:Trigger ;
    rc:cqText "Which obligations does this alert change?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ01" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?label WHERE { ?alert rc:sourceId "R2-140001" ; rc:reportsChange ?ch . ?ch rc:affectsObligation ?rob . ?rob rc:label ?label } ORDER BY ?rob""" .

rc:CQ02 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:LinkAssertion,
        rc:RegulatoryAlert,
        rc:RegulatorySummary ;
    rc:cqText "Which summaries is the alert linked to, at what confidence, and is it human-confirmed?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ02" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rsm ?score ?conf ?sme WHERE { ?alert rc:sourceId "R2-140001" . ?la rc:assertionSubject ?alert ; rc:assertionObject ?rsm ; rc:hasDecision rcv:LINKED ; rc:relevanceScore ?score ; rc:confidenceScore ?conf ; rc:hasSMEStatus ?sme . ?rsm a rc:RegulatorySummary } ORDER BY DESC(?score)""" .

rc:CQ03 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Control,
        rc:LibraryControl,
        rc:RegulatoryChange ;
    rc:cqText "Which controls are impacted, through which library control?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ03" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?control ?l1c WHERE { ?ch rc:sourceId "CHG-001" ; rc:impactsControl ?c . ?c rc:sourceId ?control ; rc:instanceOf/rc:sourceId ?l1c }""" .

rc:CQ04 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:LibraryRisk,
        rc:RegulatoryObligation,
        rc:RiskTaxonomyNode ;
    rc:cqText "Which library risks and taxonomy areas are affected?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ04" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT DISTINCT ?risk ?l1 WHERE { ?ch rc:sourceId "CHG-001" ; rc:affectsObligation ?rob . ?rob rc:givesRiseTo ?r . ?r rc:label ?risk ; rc:classifiedAs/rc:broaderRisk*/rc:label ?l1 }""" .

rc:CQ05 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Control,
        rc:Gap,
        rc:PolicyRequirement,
        rc:RegulatoryObligation,
        rc:Requirement ;
    rc:cqText "Which affected obligations have no control and no policy requirement (gaps)?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ05" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?label WHERE { ?ch rc:sourceId "CHG-001" ; rc:affectsObligation ?r . ?r rc:sourceId ?rob ; rc:label ?label . FILTER NOT EXISTS { ?x rc:satisfies ?r } FILTER NOT EXISTS { ?p rc:implementsObligation ?r } }""" .

rc:CQ06 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Condition,
        rc:Exception,
        rc:RegulatoryObligation ;
    rc:cqText "Under which conditions, and with which exceptions, does an obligation apply?" ;
    rc:label "Compliance SME" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ06" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?cond ?exc WHERE { ?r rc:sourceId ?rob . OPTIONAL { ?r rc:hasCondition/rc:statement ?cond } OPTIONAL { ?e rc:overrides ?r ; rc:statement ?exc } FILTER(BOUND(?cond) || BOUND(?exc)) }""" .

rc:CQ07 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:ApplicabilityScope,
        rc:BusinessUnit,
        rc:Jurisdiction,
        rc:LegalEntity,
        rc:Process,
        rc:Product ;
    rc:cqText "Which legal entities and businesses are in scope?" ;
    rc:label "Risk Steward" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ07" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT DISTINCT ?entity ?business WHERE { ?ch rc:sourceId "CHG-001" ; rc:affectsObligation ?r . ?r rc:appliesToScope ?s . OPTIONAL { ?s rc:scopesLegalEntity/rc:label ?entity } OPTIONAL { ?s rc:scopesBusiness/rc:label ?business } }""" .

rc:CQ08 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:RegulatoryObligation,
        rc:TemporalConstraint ;
    rc:cqText "By when must we comply?" ;
    rc:label "Risk Steward" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ08" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?type ?date WHERE { ?ch rc:sourceId "CHG-001" ; rc:affectsObligation ?r . ?r rc:sourceId ?rob ; rc:hasTemporalConstraint ?t . ?t rc:hasTemporalType ?type ; rc:effectiveDate ?date } ORDER BY ?date""" .

rc:CQ09 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Policy,
        rc:PolicyRequirement,
        rc:RegulatoryObligation ;
    rc:cqText "Which policy requirements implement each affected obligation?" ;
    rc:label "Policy Owner" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ09" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?policy ?req WHERE { ?ch rc:sourceId "CHG-001" ; rc:affectsObligation ?r . ?r rc:sourceId ?rob . ?pr rc:implementsObligation ?r ; rc:sourceId ?req ; ^rc:hasRequirement/rc:label ?policy }""" .

rc:CQ10 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Gap,
        rc:ImpactAssessment,
        rc:ImpactFinding,
        rc:RemediationAction ;
    rc:cqText "What are the findings and gaps in this assessment, and who remediates?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ10" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?gap ?coverage ?action WHERE { ?ia rc:sourceId "IA-001" ; rc:identifiesGap ?g . ?g rc:sourceId ?gap ; rc:hasCoverage ?coverage . OPTIONAL { ?g rc:remediatedBy/rc:label ?action } }""" .

rc:CQ11 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:BlastRadius,
        rc:ImpactAssessment ;
    rc:cqText "What is the blast radius of this change?" ;
    rc:label "Management" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ11" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?nObl ?nCtl ?nPol ?nLE ?nBU WHERE { ?ia rc:sourceId "IA-001" ; rc:hasBlastRadius ?b . ?b rc:nObligations ?nObl ; rc:nControls ?nCtl ; rc:nPolicyRequirements ?nPol ; rc:nLegalEntities ?nLE ; rc:nBusinesses ?nBU }""" .

rc:CQ12 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Jurisdiction,
        rc:Regulation,
        rc:Regulator ;
    rc:cqText "Which regulator issued the regulation and where does it apply?" ;
    rc:label "Compliance SME" ;
    rc:priority "COULD" ;
    rc:sourceId "CQ12" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?reg ?regulator ?jur WHERE { ?r a rc:Regulation ; rc:label ?reg ; ^rc:issues/rc:label ?regulator ; rc:appliesInJurisdiction/rc:label ?jur }""" .

rc:CQ13 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:RegulatoryAlert,
        rc:RegulatoryChange,
        rc:RiskTaxonomyNode ;
    rc:cqText "Which alerts in my risk area arrived, and which changes do they report?" ;
    rc:label "Risk Steward" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ13" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?alert ?change ?risk WHERE { ?a a rc:RegulatoryAlert ; rc:sourceId ?alert ; rc:reportsChange/rc:sourceId ?change ; rc:taggedRisk/rc:label ?risk }""" .

rc:CQ14 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Control,
        rc:ControlIssue,
        rc:ControlTest ;
    rc:cqText "Which impacted controls already have open issues or failed tests?" ;
    rc:label "Risk Steward" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ14" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?control ?issue WHERE { ?ch rc:sourceId "CHG-001" ; rc:impactsControl ?c . ?c rc:sourceId ?control ; rc:hasIssue ?i . ?i rc:status "OPEN" ; rc:label ?issue }""" .

rc:CQ15 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Actor,
        rc:Control,
        rc:ImpactAssessment,
        rc:Person,
        rc:Team ;
    rc:cqText "Who owns each impacted control, and who must sign off?" ;
    rc:label "Risk Steward" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ15" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?control ?owner ?steward WHERE { ?ia rc:sourceId "IA-001" ; rc:assignedTo/rc:label ?steward . ?ch rc:initiatesAssessment ?ia ; rc:impactsControl ?c . ?c rc:sourceId ?control ; rc:ownedBy/rc:label ?owner }""" .

rc:CQ16 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:DefinedTerm,
        rc:Provision,
        rc:RegulatoryDocument ;
    rc:cqText "Which provision and defined terms does an obligation rest on?" ;
    rc:label "Compliance SME" ;
    rc:priority "COULD" ;
    rc:sourceId "CQ16" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?provision ?term WHERE { ?r rc:sourceId ?rob ; rc:citesProvision ?p . ?p rc:label ?provision . OPTIONAL { ?p rc:definesTerm/rc:term ?term } }""" .

rc:CQ17 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:Procedure,
        rc:ProcedureStep,
        rc:Role,
        rc:System ;
    rc:cqText "How is the obligation met day to day: which procedure steps, roles and systems?" ;
    rc:label "Process Owner" ;
    rc:priority "COULD" ;
    rc:sourceId "CQ17" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?rob ?step ?role ?system WHERE { ?s a rc:ProcedureStep ; rc:satisfies ?r ; rc:label ?step . ?r rc:sourceId ?rob . OPTIONAL { ?s rc:performedBy/rc:label ?role } OPTIONAL { ?s rc:usesSystem/rc:label ?system } }""" .

rc:CQ18 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:EvidenceOccurrence,
        rc:LinkAssertion,
        rc:ModelRun ;
    rc:cqText "Why is this control in the assessment: show the evidence and the model run." ;
    rc:label "Model Risk (MRM)" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ18" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?side ?quote ?model ?prompt WHERE { ?la rc:sourceId "LA-003" ; rc:hasEvidence ?e ; rc:producedBy ?run . ?e rc:evidenceSide ?side ; rc:verbatimText ?quote . ?run rc:modelId ?model ; rc:promptVersion ?prompt }""" .

rc:CQ19 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:LinkAssertion,
        rc:SMEValidation ;
    rc:cqText "What is waiting for human review, highest confidence first?" ;
    rc:label "SME Reviewer" ;
    rc:priority "MUST" ;
    rc:sourceId "CQ19" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?la ?score WHERE { ?x a rc:LinkAssertion ; rc:sourceId ?la ; rc:hasDecision rcv:LINKED ; rc:hasSMEStatus rcv:UNREVIEWED ; rc:relevanceScore ?score } ORDER BY DESC(?score)""" .

rc:CQ20 a rc:CompetencyQuestion ;
    rc:answeredUsing rc:LinkAssertion,
        rc:ModelRun,
        rc:SMEValidation ;
    rc:cqText "How does the AI perform against human decisions, per model run?" ;
    rc:label "Model Risk (MRM)" ;
    rc:priority "SHOULD" ;
    rc:sourceId "CQ20" ;
    rc:sparql """PREFIX rc: <https://ontology.hsbc.internal/regcompliance#>
PREFIX rcv: <https://ontology.hsbc.internal/regcompliance/vocab#>
SELECT ?run (COUNT(?la) AS ?reviewed) (SUM(IF(?s = rcv:CONFIRMED,1,0)) AS ?confirmed) WHERE { ?la rc:producedBy/rc:sourceId ?run ; rc:hasSMEStatus ?s . FILTER(?s != rcv:UNREVIEWED) } GROUP BY ?run""" .

rc:affectsObligation a owl:ObjectProperty ;
    rdfs:label "affectsObligation" ;
    rdfs:comment "Materialised from CONFIRMED assertions only" ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:RegulatoryObligation ;
    rc:edgeKind "alert impact" .

rc:affectsSummary a owl:ObjectProperty ;
    rdfs:label "affectsSummary" ;
    rdfs:comment "Materialised from CONFIRMED assertions only" ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:RegulatorySummary ;
    rc:edgeKind "alert impact" .

rc:amendedBy a owl:ObjectProperty ;
    rdfs:label "amendedBy" ;
    owl:inverseOf rc:amends .

rc:answeredUsing a owl:ObjectProperty ;
    rdfs:label "answeredUsing" ;
    rdfs:comment "Class traceability" ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range rc:Entity ;
    rc:edgeKind "provenance" .

rc:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "appliesInJurisdiction" ;
    rdfs:domain rc:Regulation ;
    rdfs:range rc:Jurisdiction ;
    rc:edgeKind "business context" .

rc:appliesToScope a owl:ObjectProperty ;
    rdfs:label "appliesToScope" ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:ApplicabilityScope ;
    rc:edgeKind "business context" .

rc:arisesFrom a owl:ObjectProperty ;
    rdfs:label "arisesFrom" ;
    owl:inverseOf rc:givesRiseTo .

rc:assertionObject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assertionObject" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range rc:Entity ;
    rc:edgeKind "provenance" .

rc:assertionSubject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assertionSubject" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range rc:Entity ;
    rc:edgeKind "provenance" .

rc:assessmentOf a owl:ObjectProperty ;
    rdfs:label "assessmentOf" ;
    owl:inverseOf rc:initiatesAssessment .

rc:assessmentStatus a owl:DatatypeProperty ;
    rdfs:label "assessmentStatus" ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range xsd:string ;
    skos:definition "OPEN, IN_REVIEW or CLOSED." .

rc:assignedTo a owl:ObjectProperty ;
    rdfs:label "assignedTo" ;
    rdfs:comment "Risk Steward" ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:Person ;
    rc:edgeKind "business context" .

rc:automatedBy a owl:ObjectProperty ;
    rdfs:label "automatedBy" ;
    rdfs:domain rc:Control ;
    rdfs:range rc:System ;
    rc:edgeKind "business context" .

rc:candidateRoute a owl:DatatypeProperty ;
    rdfs:label "candidateRoute" ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string ;
    skos:definition "Candidate-generation route (e.g. RGL→RSM)." .

rc:cardinality a owl:AnnotationProperty .

rc:changeNote a owl:AnnotationProperty .

rc:changes a owl:ObjectProperty ;
    rdfs:label "changes" ;
    rdfs:domain rc:RemediationAction ;
    rdfs:range rc:Entity ;
    rc:edgeKind "alert impact" .

rc:charEnd a owl:DatatypeProperty ;
    rdfs:label "charEnd" ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:integer ;
    skos:definition "Exclusive end offset in the source text." .

rc:charStart a owl:DatatypeProperty ;
    rdfs:label "charStart" ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:integer ;
    skos:definition "Inclusive start offset in the source text." .

rc:citesProvision a owl:ObjectProperty ;
    rdfs:label "citesProvision" ;
    rdfs:domain rc:RegulatoryObligation ;
    rdfs:range rc:Provision ;
    rc:edgeKind "structural lineage" .

rc:classifiedAs a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "classifiedAs" ;
    rdfs:comment "L1–L3" ;
    rdfs:domain rc:LibraryRisk ;
    rdfs:range rc:RiskTaxonomyNode ;
    rc:edgeKind "structural lineage" .

rc:concerns a owl:ObjectProperty ;
    rdfs:label "concerns" ;
    rdfs:comment "Obligation, control, policy requirement or procedure step" ;
    rdfs:domain rc:ImpactFinding ;
    rdfs:range rc:Entity ;
    rc:edgeKind "alert impact" .

rc:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "confidenceScore" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:integer ;
    skos:definition "Model confidence 1–5." .

rc:configHash a owl:DatatypeProperty ;
    rdfs:label "configHash" ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string ;
    skos:definition "Hash of run configuration for replay." .

rc:cqText a owl:DatatypeProperty ;
    rdfs:label "cqText" ;
    rdfs:domain rc:CompetencyQuestion ;
    rdfs:range xsd:string ;
    skos:definition "The question in business language." .

rc:dataStatus a owl:AnnotationProperty .

rc:decomposesTo a owl:ObjectProperty ;
    rdfs:label "decomposesTo" ;
    owl:inverseOf rc:derivedFromSummary .

rc:definesTerm a owl:ObjectProperty ;
    rdfs:label "definesTerm" ;
    rdfs:domain rc:Provision ;
    rdfs:range rc:DefinedTerm ;
    rc:edgeKind "structural lineage" .

rc:definitionText a owl:DatatypeProperty ;
    rdfs:label "definitionText" ;
    rdfs:domain rc:DefinedTerm ;
    rdfs:range xsd:string ;
    skos:definition "Gloss of a defined term." .

rc:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derivedFrom" ;
    rdfs:comment "No orphan findings" ;
    rdfs:domain rc:ImpactFinding ;
    rdfs:range rc:LinkAssertion ;
    rc:edgeKind "provenance" .

rc:disambiguationRule a owl:AnnotationProperty .

rc:edgeKind a owl:AnnotationProperty .

rc:effectiveDate a owl:DatatypeProperty ;
    rdfs:label "effectiveDate" ;
    rdfs:domain rc:Entity ;
    rdfs:range xsd:date ;
    skos:definition "Date a regulation, change or requirement takes effect." .

rc:enforcesIn a owl:ObjectProperty ;
    rdfs:label "enforcesIn" ;
    rdfs:domain rc:Regulator ;
    rdfs:range rc:Jurisdiction ;
    rc:edgeKind "business context" .

rc:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidenceFor" ;
    owl:inverseOf rc:hasEvidence .

rc:evidenceSide a owl:DatatypeProperty ;
    rdfs:label "evidenceSide" ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range xsd:string ;
    skos:definition "SUBJECT or OBJECT: which side of an assertion the quote comes from." .

rc:exempts a owl:ObjectProperty ;
    rdfs:label "exempts" ;
    rdfs:domain rc:Exception ;
    rdfs:range rc:ProcedureStep ;
    rc:edgeKind "structural lineage" .

rc:explosionApproved a owl:DatatypeProperty ;
    rdfs:label "explosionApproved" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range xsd:boolean ;
    skos:definition "True only when a coarse (RGL) link is explicitly approved to fan out to controls." .

rc:extractedFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "extractedFrom" ;
    rdfs:comment "Source document / record" ;
    rdfs:domain rc:EvidenceOccurrence ;
    rdfs:range rc:Entity ;
    rc:edgeKind "provenance" .

rc:gateStatus a owl:DatatypeProperty ;
    rdfs:label "gateStatus" ;
    rdfs:domain rc:ModelRun ;
    rdfs:range xsd:string ;
    skos:definition "Quality gate result: PASS, FAIL or NOT_MEASURED." .

rc:governsActivity a owl:ObjectProperty ;
    rdfs:label "governsActivity" ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:ProcedureStep ;
    rc:edgeKind "structural lineage" .

rc:hasBlastRadius a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasBlastRadius" ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:BlastRadius ;
    rc:edgeKind "alert impact" .

rc:hasChangeType a owl:ObjectProperty ;
    rdfs:label "hasChangeType" ;
    rdfs:comment "Values from concept scheme rcv:ChangeType" ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range skos:Concept ;
    rc:edgeKind "business context" .

rc:hasCondition a owl:ObjectProperty ;
    rdfs:label "hasCondition" ;
    rdfs:domain rc:Requirement ;
    rdfs:range rc:Condition ;
    rc:edgeKind "structural lineage" .

rc:hasControlNature a owl:ObjectProperty ;
    rdfs:label "hasControlNature" ;
    rdfs:comment "Values from concept scheme rcv:ControlNature" ;
    rdfs:domain rc:Control ;
    rdfs:range skos:Concept ;
    rc:edgeKind "business context" .

rc:hasCoverage a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasCoverage" ;
    rdfs:comment "Values from concept scheme rcv:Coverage" ;
    rdfs:domain rc:Gap ;
    rdfs:range skos:Concept ;
    rc:edgeKind "alert impact" .

rc:hasDecision a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasDecision" ;
    rdfs:comment "Values from concept scheme rcv:LinkDecision" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept ;
    rc:edgeKind "provenance" .

rc:hasFinding a owl:ObjectProperty ;
    rdfs:label "hasFinding" ;
    rdfs:domain rc:ImpactAssessment ;
    rdfs:range rc:ImpactFinding ;
    rc:edgeKind "alert impact" .

rc:hasGranularity a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasGranularity" ;
    rdfs:comment "Values from concept scheme rcv:Granularity" ;
    rdfs:domain rc:LinkAssertion ;
    rdfs:range skos:Concept ;
    rc:edgeKind "provenance" .

