    rdfs:domain rc:Procedure ;
    rdfs:range rc:ProcedureStep ;
    rc:edgeKind "structural lineage" .

rc:hasTest a owl:ObjectProperty ;
    rdfs:label "hasTest" ;
    rdfs:domain rc:Control ;
    rdfs:range rc:ControlTest ;
    rc:edgeKind "structural lineage" .

rc:implementsObligation a owl:ObjectProperty ;
    rdfs:label "implementsObligation" ;
    rdfs:comment "Obligation → policy linkage lane" ;
    rdfs:domain rc:PolicyRequirement ;
    rdfs:range rc:RegulatoryObligation ;
    rc:edgeKind "structural lineage" .

rc:initiatesAssessment a owl:ObjectProperty ;
    rdfs:label "initiatesAssessment" ;
    rdfs:domain rc:RegulatoryChange ;
    rdfs:range rc:ImpactAssessment ;
    rc:edgeKind "alert impact" .

rc:instanceOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "instanceOf" ;
    rdfs:comment "1C → L1C (Helios)" ;
    rdfs:domain rc:Control ;
    rdfs:range rc:LibraryControl ;
    rc:edgeKind "structural lineage" .

rc:issues a owl:ObjectProperty ;
    rdfs:label "issues" ;
    rdfs:domain rc:Regulator ;
    rdfs:range rc:Regulation ;
    rc:edgeKind "structural lineage" .

rc:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigatedBy" ;
    rdfs:comment "RTCL" ;
    rdfs:domain rc:LibraryRisk ;
    rdfs:range rc:LibraryControl ;
    rc:edgeKind "structural lineage" .

rc:overrides a owl:ObjectProperty ;
    rdfs:label "overrides" ;
    rdfs:comment "Carve-out" ;
    rdfs:domain rc:Exception ;
    rdfs:range rc:Requirement ;
    rc:edgeKind "structural lineage" .

rc:partOfRegulation a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "partOfRegulation" ;
    rdfs:comment "RSM → RGL" ;
    rdfs:domain rc:RegulatorySummary ;
    rdfs:range rc:Regulation ;
    rc:edgeKind "structural lineage" .

rc:reportsChange a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reportsChange" ;
    rdfs:comment "Alert de-duplication" ;
    rdfs:domain rc:RegulatoryAlert ;
    rdfs:range rc:RegulatoryChange ;
    rc:edgeKind "alert impact" .

rc:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies" ;
    rdfs:comment "Baseline coverage ('how' satisfies 'what')" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( rc:Control rc:ProcedureStep ) ] ;
    rdfs:range rc:Requirement ;
    rc:edgeKind "structural lineage" .

rc:supersedes a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:domain rc:Regulation ;
    rdfs:range rc:Regulation ;
    rc:edgeKind "structural lineage" .

